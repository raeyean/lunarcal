{
  "name": "lunarcal",
  "version": "1.0.0",
  "main": "index.ts",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:api": "npm run build -w @lunarcal/api",
    "dev:api": "npm run build:watch -w @lunarcal/api",
    "emulator": "npm run build:api && firebase emulators:start --only functions",
    "test": "npm run test -w @lunarcal/api && npm run test -w @lunarcal/shared"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@tanstack/react-query": "^5.100.10",
    "expo": "~55.0.32",
    "expo-background-fetch": "~55.0.20",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.41",
    "expo-font": "~55.0.8",
    "expo-linear-gradient": "~55.0.18",
    "expo-notifications": "~55.0.27",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-task-manager": "~55.0.20",
    "lunar-javascript": "^1.7.7",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.15.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
