{
  "name": "lunarcal",
  "version": "1.0.0",
  "main": "index.ts",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:api": "npm run build -w @lunarcal/api",
    "dev:api": "npm run build:watch -w @lunarcal/api",
    "emulator": "npm run build:api && firebase emulators:start --only functions",
    "test": "npm run test -w @lunarcal/api && npm run test -w @lunarcal/shared"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@tanstack/react-query": "^5.100.10",
    "expo": "~58.0.25",
    "expo-background-fetch": "~58.0.13",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-linear-gradient": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-task-manager": "~58.0.14",
    "lunar-javascript": "^1.7.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~58.0.4",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
