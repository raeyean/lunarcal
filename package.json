{
  "name": "lunarcal",
  "version": "1.0.0",
  "main": "index.ts",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:api": "npm run build -w @lunarcal/api",
    "dev:api": "npm run build:watch -w @lunarcal/api",
    "emulator": "npm run build:api && firebase emulators:start --only functions",
    "test": "npm run test -w @lunarcal/api && npm run test -w @lunarcal/shared"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "^5.100.10",
    "expo": "~57.0.33",
    "expo-background-fetch": "~57.0.23",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-notifications": "~57.0.25",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-task-manager": "~57.0.23",
    "lunar-javascript": "^1.7.7",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
